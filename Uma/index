<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Squ1d 1nc - Where Analog Meets Code</title>
    <link rel="stylesheet" href="https://unpkg.com/98.css@0.1.20/dist/98.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --neon-green: #00ff41;
            --neon-pink: #ff1493;
            --bg-dark: #0a0a0a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'IBM Plex Mono', 'MS Sans Serif', sans-serif;
            background: url('https://pub-b866534d27f44635ab85ddab56429f50.r2.dev/windows.jfif') center center fixed;
            background-size: cover;
            color: #f0f0f0;
            padding: 0;
            margin: 0;
            font-size: 14px;
            position: relative;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                repeating-linear-gradient(
                    0deg,
                    transparent,
                    transparent 2px,
                    rgba(0, 255, 65, 0.03) 2px,
                    rgba(0, 255, 65, 0.03) 4px
                );
            pointer-events: none;
            animation: scan 8s linear infinite;
            z-index: 1;
        }

        body > * {
            position: relative;
            z-index: 2;
        }

        .glitch {
            position: relative;
            animation: glitch 3s infinite;
        }

        @keyframes glitch {
            0%, 90%, 100% {
                text-shadow: var(--neon-green) 0px 0px 10px, var(--neon-green) 0px 0px 20px, var(--neon-green) 0px 0px 30px;
            }
            92% {
                text-shadow: 2px 0 var(--neon-pink), -2px 0 var(--neon-green);
                transform: translate(-2px, 0);
            }
            94% {
                text-shadow: -2px 0 var(--neon-pink), 2px 0 var(--neon-green);
                transform: translate(2px, 0);
            }
        }

        /* Landing Section */
        .landing {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        .landing .window {
            max-width: 700px;
            width: 100%;
            position: relative;
            z-index: 10;
        }

        .landing-content {
            text-align: center;
            padding: 40px 20px;
        }

        .logo {
            font-size: 48px;
            font-weight: bold;
            letter-spacing: 4px;
            margin-bottom: 20px;
            color: var(--neon-green);
            text-shadow: none;
        }

        .logo.glitch {
            animation: glitch-logo 0.3s infinite;
        }

        @keyframes glitch-logo {
            0% {
                text-shadow: 0.05em 0 0 var(--neon-pink), -0.05em -0.025em 0 var(--neon-green);
            }
            14% {
                text-shadow: 0.05em 0 0 var(--neon-pink), -0.05em -0.025em 0 var(--neon-green);
            }
            15% {
                text-shadow: -0.05em -0.025em 0 var(--neon-pink), 0.05em 0.025em 0 var(--neon-green);
            }
            49% {
                text-shadow: -0.05em -0.025em 0 var(--neon-pink), 0.05em 0.025em 0 var(--neon-green);
            }
            50% {
                text-shadow: 0.025em 0.05em 0 var(--neon-pink), 0.05em 0 0 var(--neon-green);
            }
            99% {
                text-shadow: 0.025em 0.05em 0 var(--neon-pink), 0.05em 0 0 var(--neon-green);
            }
            100% {
                text-shadow: -0.025em 0 0 var(--neon-pink), -0.025em -0.025em 0 var(--neon-green);
            }
        }

        .tagline {
            font-size: 20px;
            margin-bottom: 15px;
            color: var(--neon-pink);
            font-weight: 600;
        }

        .subtitle {
            font-size: 14px;
            color: #888;
            margin-bottom: 30px;
        }

        .cta-buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .cta-button {
            font-size: 16px;
            padding: 10px 30px;
            font-weight: bold;
            transition: all 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .cta-button:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--neon-green);
        }

        .scroll-indicator {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 24px;
            animation: bounce 2s infinite;
            cursor: pointer;
            z-index: 10;
            background: #c0c0c0;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid;
            border-color: #fff #000 #000 #fff;
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
            40% { transform: translateX(-50%) translateY(-10px); }
            60% { transform: translateX(-50%) translateY(-5px); }
        }

        /* Content Sections */
        .content-section {
            padding: 80px 20px;
            max-width: 1200px;
            margin: 0 auto;
            margin-bottom: 150px;
        }

        .window {
            margin-bottom: 30px;
        }

        /* Custom Title Bars */
        .title-bar {
            background: var(--neon-pink) !important;
            padding: 3px 4px !important;
        }

        .title-bar-text {
            color: var(--neon-green) !important;
            font-weight: bold !important;
            text-shadow: 0 0 5px var(--neon-green), 0 0 10px var(--neon-green);
        }

        .section-title {
            font-size: 28px;
            font-weight: bold;
            margin-bottom: 25px;
            color: var(--neon-green);
            padding: 12px;
            background: #000;
            border: 2px solid var(--neon-green);
            text-transform: uppercase;
            letter-spacing: 3px;
            text-shadow: 0 0 10px var(--neon-green);
        }

        /* Projects Grid */
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .project-card {
            cursor: pointer;
            transition: all 0.2s ease;
            border: 2px solid;
            border-color: #fff #000 #000 #fff;
            background: #c0c0c0;
        }

        .project-card:hover {
            transform: translateY(-3px) rotate(-0.5deg);
            box-shadow: 4px 4px 0px rgba(0, 0, 0, 0.5), 0 0 20px var(--neon-green);
        }

        .project-card-header {
            background: var(--neon-pink);
            color: var(--neon-green);
            padding: 8px 10px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #000;
            text-shadow: 0 0 5px var(--neon-green);
        }

        .project-icon {
            font-size: 24px;
            filter: drop-shadow(0 0 3px var(--neon-green));
        }

        .project-status {
            font-size: 10px;
            padding: 4px 8px;
            background: #000;
            color: var(--neon-green);
            border: 1px solid var(--neon-green);
            text-transform: uppercase;
            font-weight: bold;
        }

        .status-live {
            background: var(--neon-green);
            color: #000;
            border-color: var(--neon-green);
        }

        .status-dev {
            background: var(--neon-pink);
            color: #000;
            border-color: var(--neon-pink);
        }

        .project-card-body {
            padding: 15px;
            background: #c0c0c0;
        }

        .project-title {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 10px;
            color: #000;
        }

        .project-description {
            font-size: 13px;
            line-height: 1.6;
            color: #000;
            margin-bottom: 12px;
        }

        .project-links {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .project-link button:hover {
            box-shadow: 0 0 10px var(--neon-green);
        }

        /* Ethos Section */
        .ethos-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .ethos-item {
            border: 2px solid;
            border-color: #fff #000 #000 #fff;
            background: #c0c0c0;
            padding: 20px;
            text-align: center;
            transition: all 0.2s ease;
        }

        .ethos-item:hover {
            transform: translateY(-3px);
            box-shadow: 4px 4px 0px rgba(0, 0, 0, 0.5), 0 0 15px var(--neon-green);
        }

        .ethos-icon {
            font-size: 40px;
            margin-bottom: 10px;
            filter: drop-shadow(0 0 3px var(--neon-green));
        }

        .ethos-title {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 8px;
            color: #000;
        }

        .ethos-text {
            font-size: 13px;
            color: #000;
            line-height: 1.5;
        }

        /* Manifesto */
        .manifesto-content {
            padding: 30px;
            font-size: 16px;
            line-height: 1.8;
            font-style: italic;
            text-align: center;
            background: #c0c0c0;
            color: #000;
        }

        .manifesto-content p {
            margin-bottom: 30px;
            font-weight: 500;
        }

        /* Footer */
        .footer-section {
            background: #c0c0c0;
            border-top: 2px solid;
            border-color: #fff #000;
            padding: 30px 20px;
            text-align: center;
            margin-top: 40px;
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }

        .social-links button:hover {
            box-shadow: 0 0 10px var(--neon-green);
        }

        .copyright {
            font-size: 12px;
            color: #000;
            margin-top: 10px;
        }

        .blink {
            animation: blink 1s infinite;
        }

        @keyframes blink {
            0%, 50%, 100% { opacity: 1; }
            25%, 75% { opacity: 0; }
        }

        @media (max-width: 768px) {
            .logo {
                font-size: 32px;
            }
            
            .tagline {
                font-size: 16px;
            }

            .projects-grid,
            .ethos-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
